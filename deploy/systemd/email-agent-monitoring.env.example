# Private routing only. Store the filled file outside Git (directory 0700, file 0600).
# Copy these values from the existing daily configuration; target must equal approver.
TELEGRAM_APPROVER_USER_ID=REPLACE_WITH_PRIVATE_OPERATOR_ID
TELEGRAM_TARGET_CHAT_ID=REPLACE_WITH_SAME_PRIVATE_OPERATOR_ID
TELEGRAM_ACCOUNT_ID=default
# OpenClaw owns Telegram credentials. Do not add Gmail, model or bot-token secrets.
# Use the same absolute directory as the daily service (or omit in BOTH).
EMAIL_AGENT_MONITOR_STATE_DIR=/absolute/private/monitoring-state
