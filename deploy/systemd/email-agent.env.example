# Copy to ~/.config/email-agent/email-agent.env outside the repo; chmod 600.
# Fill these in privately. Empty values fail closed.
GOG_ACCOUNT=
TARGET_SENDER=
# Only the exact lower-case value true opts in. Keep false for TASK-009A.
EMAIL_AGENT_AUTO_SEND=false

# Required for a model turn: dedicated text-only OpenClaw configuration/state.
# Use absolute Linux paths, outside this repository and outside pipeline state.
OPENCLAW_CONFIG_PATH=
OPENCLAW_STATE_DIR=

# Optional: absent XDG_STATE_HOME defaults to ~/.local/state.
# XDG_STATE_HOME=/absolute/path/to/state-parent
# PATH=/absolute/path/to/openclaw-bin:/absolute/path/to/gog-bin:/usr/local/bin:/usr/bin:/bin
# systemd EnvironmentFile does NOT expand ~, $HOME or other shell variables.
# Add keyring/model credentials ONLY to the real protected file or existing
# protected credential stores. Never fill them into this committed example.

