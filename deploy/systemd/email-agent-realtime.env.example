# Private copy: ~/.config/email-agent/realtime.env (0600). Absolute Linux paths.
GOG_ACCOUNT=
GCP_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
# Required numeric Telegram chat ID; no built-in recipient. Bot credentials stay
# in the existing private OpenClaw channel config, never in this example.
TELEGRAM_TARGET_CHAT_ID=
# Enable only after the native OpenClaw plugin has been installed and audited.
EMAIL_AGENT_REPLY_APPROVAL=false
# Independent of reply approval. Configure the same private allowlist in the
# subscriber and label plugin's private environment. No writer credential here.
EMAIL_AGENT_LABEL_APPROVAL=false
EMAIL_AGENT_LABEL_ALLOWLIST_JSON='["Công việc","Hóa đơn","Khách hàng"]'
TELEGRAM_APPROVER_USER_ID=
TELEGRAM_ACCOUNT_ID=default
EMAIL_AGENT_AUTO_SEND=false
# Google authorized_user JSON, outside repo, chmod 600; existing read-send grant.
GMAIL_AUTHORIZED_USER_FILE=
# Pub/Sub uses separate ADC identity with roles/pubsub.subscriber on subscription.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json
# No AI is required to produce a recoverable notification; summary defaults to "".
EMAIL_AGENT_SUMMARY_MODE=none
# Optional mode openclaw: use existing separate deny-all-tools/silent config.
OPENCLAW_CONFIG_PATH=
OPENCLAW_STATE_DIR=
# XDG_STATE_HOME=/absolute/path/to/state-parent
# PATH=/absolute/path/to/openclaw-bin:/usr/local/bin:/usr/bin:/bin
